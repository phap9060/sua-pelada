{
  "installCommand": "bun install && cd ../back && bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sua-pelada-production.up.railway.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
